<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app-exe".
  Copy this into SignPath: project "shoukulauncher" → Artifact configurations → New, slug "app-exe".
  The GitHub artifact arrives as a ZIP containing shoukugames.exe.
-->
